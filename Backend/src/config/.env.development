# ─── Servidor ────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Base de datos ───────────────────────────────────────────
# Reemplazá con tu string de conexión de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/<dbname>

# ─── Admin (panel de administración) ─────────────────────────
ADMIN_NAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=clave_secreta_para_desarrollo_local_cambiar_en_produccion

# ─── WhatsApp ─────────────────────────────────────────────────
STORE_WHATSAPP=5491112345678

# ─── Email (notificaciones de nuevos registros) ───────────────
# Podés dejarlo vacío en desarrollo si no necesitás notificaciones
GMAIL_ACCOUNT=tucuenta@gmail.com
GMAIL_PASSWORD=tu_app_password

# ─── Cloudflare R2 (almacenamiento de imágenes) ───────────────
R2_ACCOUNT_ID=tu_account_id
R2_ACCESS_KEY_ID=tu_access_key
R2_SECRET_ACCESS_KEY=tu_secret_key
R2_BUCKET_NAME=catalogoayp
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ─── Frontend ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

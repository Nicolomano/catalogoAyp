# ─── Servidor ────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Base de datos ───────────────────────────────────────────
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/<dbname>

# ─── Admin (panel de administración) ─────────────────────────
ADMIN_NAME=admin
ADMIN_PASSWORD=tu_password_admin
JWT_SECRET=una_clave_secreta_larga_y_random

# ─── WhatsApp ─────────────────────────────────────────────────
# Solo el número, sin + ni espacios. Ej: 5491112345678
STORE_WHATSAPP=5491112345678

# ─── Email (notificaciones de nuevos registros) ───────────────
GMAIL_ACCOUNT=tucuenta@gmail.com
GMAIL_PASSWORD=tu_app_password_de_gmail
# IMPORTANTE: usar una "App Password" de Google, no tu contraseña normal.
# Activar en: https://myaccount.google.com/apppasswords

# ─── Cloudflare R2 (almacenamiento de imágenes) ───────────────
R2_ACCOUNT_ID=tu_account_id_de_cloudflare
R2_ACCESS_KEY_ID=tu_r2_access_key
R2_SECRET_ACCESS_KEY=tu_r2_secret_key
R2_BUCKET_NAME=catalogoayp
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Si tenés dominio propio: https://img.tudominio.com

# ─── Frontend (para el sitemap.xml) ──────────────────────────
FRONTEND_URL=https://tudominio.vercel.app
